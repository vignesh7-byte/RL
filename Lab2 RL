      "source": [
        "import random\n",
        "\n",
        "machines = ['A', 'B', 'C']\n",
        "epsilon = 0.2\n",
        "n_plays = 10\n",
        "\n",
        "N = [0, 0, 0]\n",
        "R = [0, 0, 0]\n",
        "Q = [0.0, 0.0, 0.0]\n",
        "\n",
        "total_reward = 0\n",
        "\n",
        "for play in range(1, n_plays + 1):\n",
        "    r = random.random()\n",
        "\n",
        "    if r < epsilon:\n",
        "        selected = random.randint(0, 2)\n",
        "        decision = \"Exploration\"\n",
        "    else:\n",
        "        max_q = max(Q)\n",
        "        best_machines = [i for i in range(3) if Q[i] == max_q]\n",
        "        selected = random.choice(best_machines)\n",
        "        decision = \"Exploitation\"\n",
        "\n",
        "    print(f\"\\nPlay {play}\")\n",
        "    print(f\"Random number: {r:.4f}\")\n",
        "    print(f\"Decision: {decision}\")\n",
        "    print(f\"Play with machine {machines[selected]}\")\n",
        "\n",
        "    reward = float(input(\"Enter reward: \"))\n",
        "\n",
        "    N[selected] += 1\n",
        "    R[selected] += reward\n",
        "    Q[selected] = Q[selected] + (reward - Q[selected]) / N[selected]\n",
        "\n",
        "    total_reward += reward\n",
        "\n",
        "    print(f\"N({machines[selected]}) = {N[selected]}\")\n",
        "    print(f\"R({machines[selected]}) = {R[selected]:g}\")\n",
        "    print(f\"Q({machines[selected]}) = {Q[selected]:.2f}\")\n",
        "\n",
        "print(\"\\nFinal Results\")\n",
        "print(\"-------------------------\")\n",
        "\n",
        "for i in range(3):\n",
        "    print(f\"Machine {machines[i]}\")\n",
        "    print(f\"Participation Count N({machines[i]}) = {N[i]}\")\n",
        "    print(f\"Total Reward R({machines[i]}) = {R[i]:g}\")\n",
        "    print(f\"Q({machines[i]}) = {Q[i]:.2f}\")\n",
        "    print()\n",
        "\n",
        "print(f\"Total Reward after 10 plays = {total_reward:g}\")\n"
      ],
